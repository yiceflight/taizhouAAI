+    #[test]
+    fn review_manual_today_refresh_must_not_skip_pending_history() {
+        let mut db = connect(Path::new(":memory:")).unwrap();
+        let old = (current_hour() - Duration::days(20)).format(FORMAT).to_string();
+        put(&db, "query_through", &old).unwrap();
+        let (start, end) = requested_window("today").unwrap();
+        let batch = Batch { url: SOURCE_URL.into(), city: "泰州市".into(), city_code: "321200".into(), unit: "μg/m³".into(), data_source: "A_6".into(), common_site_type: "30".into(), start_time:start.clone(), end_time:end.clone(), rows:vec![] };
+        persist(&mut db, batch, &start, &end).unwrap();
+        let next_start = window(&db).unwrap().0;
+        assert!(parse(&next_start).unwrap() <= parse(&old).unwrap(), "manual today refresh jumped automatic backfill from {old} to {next_start}");
+    }
+}
