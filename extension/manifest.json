{
  "manifest_version": 3,
  "name": "江苏省泰州环境监测中心智能监测系统 · 浏览器桥接",
  "version": "0.7.40",
  "description": "江苏省泰州环境监测中心智能监测系统的 Chrome 数据采集与 CDP 桥接插件。",
  "permissions": [
    "debugger",
    "tabs",
    "alarms",
    "storage",
    "tabGroups"
  ],
  "host_permissions": [
    "http://61.155.4.60:18080/*",
    "https://fh.dji.com/*",
    "https://aai.airins.cn/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://61.155.4.60:18080/*",
        "https://fh.dji.com/*",
        "https://aai.airins.cn/*"
      ],
      "js": [
        "src/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "minimum_chrome_version": "120",
  "key": "",
  "action": {
    "default_title": "连接桌面客户端"
  }
}
