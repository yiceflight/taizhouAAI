{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "江苏省泰州环境监测中心智能监测系统",
  "version": "0.2.3",
  "identifier": "com.taizhou.aai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "江苏省泰州环境监测中心智能监测系统",
        "width": 960,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../extension/": "extension/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFMkVGREY2RDFFRjAzNkUKUldSdUErL1I5djB1bnZlWGdQalRDVmFCYTlOSHV5TnFrSVZmSDBHL0hBQWhzMzNnV0pxR0ZtaEsK",
      "endpoints": [
        "https://taizhou-aai-updates.oss-cn-hangzhou.aliyuncs.com/client/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
